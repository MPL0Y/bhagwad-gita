// Cloudflare Worker serving The Bhagavad Gita Sanctuary as static assets. Pushing to main deploys (Workers Builds).
{
  "name": "gita",
  "compatibility_date": "2026-10-15",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "gita.agenticrabbit.com",
      "custom_domain": true
    }
  ]
}
