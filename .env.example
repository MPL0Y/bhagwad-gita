# Payment Gateway Configuration for The Gita Sanctuary
# ----------------------------------------------------
# 1. RAZORPAY (Instant in India, zero waitlist, supports UPI, GPay, PhonePe, Paytm, Cards)
# Sign up at: https://razorpay.com
# Get your Key ID from: Dashboard -> Settings -> API Keys
VITE_RAZORPAY_KEY_ID=rzp_live_your_key_id_here

# 2. RAZORPAY PAYMENT PAGES / LINKS (Zero-code payment URLs)
# Create in Dashboard -> Payment Links / Payment Pages
VITE_PAYMENT_LINK_SEEKER_INR=https://rzp.io/l/your_seeker_link
VITE_PAYMENT_LINK_SADHAK_INR=https://rzp.io/l/your_sadhak_link
VITE_PAYMENT_LINK_PATRON_INR=https://rzp.io/l/your_patron_link

# 3. GLOBAL PAYMENT LINKS (Dodo Payments / Lemon Squeezy for USD & international cards)
# Dodo Payments (https://dodopayments.com - built for India/global SaaS) or Lemon Squeezy
VITE_PAYMENT_LINK_SEEKER_USD=https://checkout.dodopayments.com/buy/seeker
VITE_PAYMENT_LINK_SADHAK_USD=https://checkout.dodopayments.com/buy/sadhak
VITE_PAYMENT_LINK_PATRON_USD=https://checkout.dodopayments.com/buy/patron
